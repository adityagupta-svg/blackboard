# Copy this file to .env and fill in SF_CLIENT_ID before running `npm start`.
# Every other variable already has a working default for the BlackBoarDemo
# scratch org baked into server.js — only override one if you're pointing this
# site at a different org or environment.

# Origin of the Experience Cloud site (Partner Hub), no trailing slash, no site
# path. Default: the BlackBoarDemo scratch org.
SF_ORIGIN=https://agility-power-1332-dev-ed.scratch.my.site.com

# The Experience Cloud site's BROWSABLE URL path prefix (the LWR portal), NOT
# the auto-generated "...vforcesite" prefix from the Network metadata's
# <urlPathPrefix>. All three OAuth calls (authorize/token/singleaccess) use
# this prefix.
SF_SITE_PATH=partnerhub

# Callback URL registered on the External Client App's OAuth settings. Must
# match byte for byte or Salesforce answers redirect_uri_mismatch. Uses the
# "vforcesite" prefix, unlike SF_SITE_PATH above — that split is intentional,
# see README.md. This URL is registered only; the server never navigates to it.
SF_CALLBACK_URL=https://agility-power-1332-dev-ed.scratch.my.site.com/partnerhubvforcesite/services/oauth2/echo

# Space-separated OAuth scopes requested on login (commas do not work). "web"
# is mandatory: /services/oauth2/singleaccess rejects a token that carries
# neither "web" nor "full". Every scope listed here must also be selected on
# the External Client App itself.
SF_SCOPES=openid api web

# The LWR route appended after the site prefix once the visitor is bridged in.
# Left empty on purpose: the Partner Hub portal HOME forwards a signed-in
# visitor to the dashboard on its own, so there's no route name to keep in
# sync here.
SF_LANDING_ROUTE=

# Consumer Key of the External Client App "Blackboard_Partner_Website".
# REQUIRED — there is no default, and the server refuses to start without it.
# Get it from Setup -> External Client App Manager -> Blackboard_Partner_Website
# -> Settings -> OAuth -> Manage Consumer Details, AFTER deploying the app's
# metadata (see README.md "Org-side setup checklist"). This is a public client
# (PKCE, no consumer secret), so the key itself is not a secret in the usual
# sense — but it is per-org, so it still doesn't belong in source with a
# default value.
SF_CLIENT_ID=

# Full URL of the guest Apex REST endpoint that creates the Lead record.
# Confirmed reachable for the BlackBoarDemo org during planning.
SF_LEAD_ENDPOINT=https://agility-power-1332-dev-ed.scratch.my.site.com/services/apexrest/Chgon/bb/v1/lead

# Local port the Node server listens on. Not read by anything on Vercel.
PORT=5500

# Timeout (ms) applied to every outbound call to Salesforce. Optional — this is
# a safety valve, not something you should normally need to change.
SF_FETCH_TIMEOUT_MS=15000
